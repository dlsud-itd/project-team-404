        {
          "name": "Get James priorities and capture Medium",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('List contains Low, Medium, and High priorities', function () { pm.expect(body).to.be.an('array'); pm.expect(body.some((p) => p.name === 'Low')).to.equal(true); pm.expect(body.some((p) => p.name === 'Medium')).to.equal(true); pm.expect(body.some((p) => p.name === 'High')).to.equal(true); const medium = body.find((p) => p.name === 'Medium'); pm.expect(medium).to.not.equal(undefined); pm.environment.set('reassignPriorityId', String(medium.id)); });"
                ]
              }
            }
          ],
