        {
          "name": "Registered user has exactly one default Inbox",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Inbox count and ID match signup\", function () { const body = pm.response.json(); pm.expect(body).to.be.an('array'); const inboxes = body.filter((project) => project.isInbox === true); pm.expect(inboxes).to.have.lengthOf(1); pm.expect(String(inboxes[0].id)).to.equal(pm.environment.get('registeredInboxId')); });"
                ]
              }
            }
