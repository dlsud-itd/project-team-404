        {
          "name": "Login with newly registered user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Created credentials log in\", function () { const body = pm.response.json(); pm.expect(body.token).to.be.a('string').and.not.empty; pm.expect(body.user.username).to.equal(pm.environment.get('newUsername')); pm.expect(body.user.email).to.equal(pm.environment.get('uniqueEmail')); pm.environment.set('token', body.token); });"
                ]
              }
            }
          ],
