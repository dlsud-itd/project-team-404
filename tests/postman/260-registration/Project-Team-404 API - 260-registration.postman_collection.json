      "name": "260-registration",
      "item": [
        {
          "name": "Register a new user and Inbox",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = pm.variables.replaceIn('{{$guid}}').replace(/-/g, '').slice(0, 10);",
                  "pm.environment.set('newUsername', 'pm' + suffix);",
                  "pm.environment.set('uniqueEmail', 'postman.' + suffix + '@example.com');",
                  "pm.environment.set('availableUsername', 'free' + suffix);",
                  "pm.environment.set('availableEmail', 'available.' + suffix + '@example.com');",
                  "pm.environment.set('signupPassword', 'PostmanPass123');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Signup returns user and Inbox IDs\", function () { const body = pm.response.json(); pm.expect(body.userId).to.be.a('string').and.not.empty; pm.expect(body.inboxProjectId).to.be.a('number'); pm.environment.set('registeredUserId', body.userId); pm.environment.set('registeredInboxId', String(body.inboxProjectId)); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{newUsername}}\",\n  \"email\": \"{{uniqueEmail}}\",\n  \"password\": \"{{signupPassword}}\",\n  \"confirmPassword\": \"{{signupPassword}}\",\n  \"timezone\": \"Asia/Manila\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "signup"]
            }
          },
          "response": []
        },
