{
  "info": {
    "_postman_id": "34100000-0000-4000-8000-000000000001",
    "name": "Project-Team-404 API - 341-overdue-tasks",
    "description": "Overdue dashboard API checks. Setup creates disposable tasks and a fresh empty-result account; run only against a dedicated test database.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "341-overdue-tasks",
      "description": "Run in order. Setup creates relative-deadline fixtures, followed by isolated behavior cases and timezone restoration.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let runId = pm.environment.get('runId');",
              "if (!runId) { runId = pm.variables.replaceIn('{{$guid}}'); pm.environment.set('runId', runId); }",
              "if (pm.environment.get('dateRunId') !== runId) {",
              "  const now = new Date();",
              "  const setOffset = (key, milliseconds) => pm.environment.set(key, new Date(now.getTime() + milliseconds).toISOString());",
              "  setOffset('deadlineOldest', -3 * 60 * 60 * 1000);",
              "  const todayParts = new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Manila', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(now);",
              "  const localToday = todayParts.find((part) => part.type === 'year').value + '-' + todayParts.find((part) => part.type === 'month').value + '-' + todayParts.find((part) => part.type === 'day').value;",
              "  const localMidnight = new Date(localToday + 'T00:00:00+08:00');",
              "  pm.environment.set('deadlineEarlierToday', new Date(Math.max(now.getTime() - 60 * 1000, localMidnight.getTime())).toISOString());",
              "  setOffset('deadlineFuture', 60 * 60 * 1000);",
              "  setOffset('deadlineCompleted', -20 * 60 * 1000);",
              "  setOffset('deadlineArchived', -15 * 60 * 1000);",
              "  setOffset('deadlineDeleted', -10 * 60 * 1000);",
              "  setOffset('deadlineShared', -5 * 60 * 1000);",
              "  pm.environment.set('dateRunId', runId);",
              "}"
            ]
          }
        }
      ],
