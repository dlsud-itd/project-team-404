                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Login returns a token and expected user\", function () { const body = pm.response.json(); pm.expect(body.token).to.be.a('string').and.not.empty; pm.expect(body.user).to.include({ username: 'james', email: 'james@example.com', timezone: 'Asia/Manila' }); pm.expect(body.user.id).to.be.a('string').and.not.empty; pm.expect(body.user.inboxProjectId).to.be.a('number'); pm.environment.set('token', body.token); });"
