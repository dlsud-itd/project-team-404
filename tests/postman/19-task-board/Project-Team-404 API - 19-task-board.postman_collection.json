        {
          "name": "10 Get three-column board",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Board returns 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Board has three status columns and counts', function () { pm.expect(body.columns).to.have.keys('todo','inProgress','done'); pm.expect(body.counts).to.have.keys('todo','inProgress','done'); });",
                  "pm.test('Tasks are ordered within each column', function () { for (const column of Object.values(body.columns)) { pm.expect(column.map(task => task.position)).to.eql([...column].map(task => task.position).sort((a,b) => a-b)); } });",
                  "pm.test('Completion state agrees with Done status', function () { for (const task of [...body.columns.todo,...body.columns.inProgress]) pm.expect(task.isDone).to.equal(false); for (const task of body.columns.done) pm.expect(task.isDone).to.equal(true); });",
                  "pm.environment.set('todoIds', JSON.stringify(body.columns.todo.map(task => task.id)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/tasks/board?projectId={{projectId}}"
          }
        },
        {
          "name": "11 Task filters apply to board columns",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Filtered board returns 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "const ids = [...body.columns.todo,...body.columns.inProgress,...body.columns.done].map(task => String(task.id));",
                  "pm.test('Priority filter keeps the matching task only', function () { pm.expect(ids).to.include(pm.environment.get('taskTodoId')); pm.expect(ids).not.to.include(pm.environment.get('taskLowId')); });",
                  "pm.test('Filtered counts match filtered results', function () { pm.expect(body.counts.todo + body.counts.inProgress + body.counts.done).to.equal(ids.length); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/tasks/board?projectId={{projectId}}&priority=high"
