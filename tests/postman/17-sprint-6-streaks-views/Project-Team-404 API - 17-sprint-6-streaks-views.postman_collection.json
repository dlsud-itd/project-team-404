        {
          "name": "10 Get tasks and capture active IDs",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const tasks=pm.response.json();",
                  "pm.test('Position field is present', function () { pm.expect(tasks).to.be.an('array'); tasks.forEach(task => pm.expect(task).to.have.property('position')); });",
                  "const activeIds=tasks.filter(task => !task.isDone).map(task => task.id);",
                  "pm.test('Active task set is not empty', function () { pm.expect(activeIds).to.not.be.empty; });",
                  "pm.environment.set('activeTaskIds', JSON.stringify(activeIds.reverse()));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/tasks?projectId={{projectId}}&orderBy=position&orderDirection=asc&page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"],
              "query": [
                { "key": "projectId", "value": "{{projectId}}" },
                { "key": "orderBy", "value": "position" },
                { "key": "orderDirection", "value": "asc" },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          }
        },
