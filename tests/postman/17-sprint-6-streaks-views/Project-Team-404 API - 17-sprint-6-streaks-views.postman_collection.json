              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const response=pm.response.json();",
                  "pm.test('Three board columns and counts exist', function () { pm.expect(response.columns).to.have.property('todo').that.is.an('array'); pm.expect(response.columns).to.have.property('inProgress').that.is.an('array'); pm.expect(response.columns).to.have.property('done').that.is.an('array'); pm.expect(response.counts).to.have.keys('todo','inProgress','done'); });",
                  "pm.environment.set('boardTodoIds', JSON.stringify(response.columns.todo.map(task => task.id).reverse()));"
                ]
              }
