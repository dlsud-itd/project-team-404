{
  "name": "frontend",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "set-env": "node --env-file-if-exists=.env scripts/set-env.mjs",
    "prestart": "npm run set-env",
    "start": "ng serve",
    "prebuild": "npm run set-env",
    "build": "ng build",
    "prewatch": "npm run set-env",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run set-env",
    "pretest:run": "npm run set-env",
    "pretest:watch": "npm run set-env",
    "test": "ng test --watch=false",
    "test:run": "ng test --watch=false",
    "test:watch": "ng test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rimraf dist .angular/cache",
    "serve:ssr:frontend": "node dist/frontend/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.8",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^9.39.1",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "eslint": "^9.39.1",
    "globals": "^17.6.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.0.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.0.8"
  }
}
