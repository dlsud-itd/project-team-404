# Public values bundled into the browser build. Never put secrets here.
# Supabase: Dashboard > Project Settings > API Keys
NG_APP_SUPABASE_URL=https://<project-ref>.supabase.co
NG_APP_SUPABASE_ANON_KEY=sb_publishable_replace_me

# Express API base URL, without a trailing slash.
# Local: http://localhost:3000
# Production: your backend service URL
NG_APP_API_BASE_URL=http://localhost:3000
