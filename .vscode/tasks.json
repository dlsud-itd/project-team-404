{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "💻 Frontend: Dev",
      "type": "npm",
      "script": "start",
      "path": "frontend",
      "presentation": {
        "group": "dev-env",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🖥️ Backend: Dev",
      "type": "npm",
      "script": "dev",
      "path": "backend",
      "presentation": {
        "group": "dev-env",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🚀 Dev: Start All",
      "dependsOn": ["💻 Frontend: Dev", "🖥️ Backend: Dev"],
      "dependsOrder": "parallel",
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "🧪 Frontend: Tests (watch)",
      "type": "npm",
      "script": "test:watch",
      "path": "frontend",
      "presentation": {
        "group": "testing",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🧪 Frontend: Tests (run once)",
      "type": "npm",
      "script": "test:run",
      "path": "frontend",
      "presentation": {
        "group": "testing",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🧪 E2E: Tests (run once)",
      "type": "npm",
      "script": "test:e2e",
      "presentation": {
        "group": "testing",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🧪 Frontend: Tests (coverage report)",
      "type": "npm",
      "script": "test",
      "path": "frontend",
      "args": ["--", "--coverage"],
      "presentation": {
        "group": "testing",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🧪 Backend: Tests (watch)",
      "type": "npm",
      "script": "test:watch",
      "path": "backend",
      "presentation": {
        "group": "testing",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🧪 Backend: Tests (run once)",
      "type": "npm",
      "script": "test",
      "path": "backend",
      "options": {
        "env": {
          "NODE_ENV": "test",
          "CORS_ALLOWED_ORIGINS": "http://localhost:4200"
        }
      },
      "presentation": {
        "group": "testing",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🧪 Backend: Tests (coverage report)",
      "type": "npm",
      "script": "test:report",
      "path": "backend",
      "presentation": {
        "group": "testing",
        "panel": "dedicated",
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "📊 Test Reports: Generate",
      "type": "shell",
      "command": "npm --prefix backend run test:report ; npm --prefix frontend run test -- --coverage ; node scripts/collect-reports.mjs",
      "presentation": {
        "group": "testing",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🔁 Regression: Run All",
      "type": "npm",
      "script": "test:regression",
      "path": ".",
      "detail": "Runs backend unit, backend integration, project API regression, frontend unit and integration, E2E, then frontend regression specs. Fails on any failed, skipped, or missing suite.",
      "problemMatcher": [],
      "presentation": {
        "group": "testing",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🔍 Frontend: Lint",
      "type": "npm",
      "script": "lint",
      "path": "frontend",
      "problemMatcher": ["$eslint-stylish"],
      "presentation": {
        "group": "quality",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🔍 Backend: Lint",
      "type": "npm",
      "script": "lint",
      "path": "backend",
      "problemMatcher": ["$eslint-stylish"],
      "presentation": {
        "group": "quality",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🎨 Format: Check",
      "type": "npm",
      "script": "format:check",
      "path": ".",
      "presentation": {
        "group": "quality",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🎨 Format: Fix",
      "type": "npm",
      "script": "format",
      "path": ".",
      "presentation": {
        "group": "quality",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🏗️ Frontend: Build",
      "type": "npm",
      "script": "build",
      "path": "frontend",
      "presentation": {
        "group": "build",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🏗️ Frontend: Build (watch)",
      "type": "npm",
      "script": "watch",
      "path": "frontend",
      "presentation": {
        "group": "build",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🏗️ Backend: Build",
      "type": "npm",
      "script": "build",
      "path": "backend",
      "presentation": {
        "group": "build",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🔎 Backend: Typecheck",
      "type": "npm",
      "script": "typecheck",
      "path": "backend",
      "presentation": {
        "group": "quality",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🔧 Frontend: Lint (fix)",
      "type": "npm",
      "script": "lint:fix",
      "path": "frontend",
      "presentation": {
        "group": "quality",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🔧 Backend: Lint (fix)",
      "type": "npm",
      "script": "lint:fix",
      "path": "backend",
      "presentation": {
        "group": "quality",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "✅ CI: Verify All",
      "dependsOn": [
        "🧪 Frontend: Tests (run once)",
        "🧪 Backend: Tests (run once)",
        "🔍 Frontend: Lint",
        "🔍 Backend: Lint",
        "🎨 Format: Check",
        "🏗️ Frontend: Build",
        "🏗️ Backend: Build"
      ],
      "dependsOrder": "parallel",
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "📦 Install All Dependencies",
      "type": "npm",
      "script": "install:all",
      "path": ".",
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "🛠️ Setup: Create Environment Files",
      "type": "process",
      "command": "node",
      "args": ["scripts/setup-env.mjs"],
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "🧹 Clean: Build Artifacts",
      "type": "npm",
      "script": "clean",
      "path": ".",
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "🔐 Supabase: Login",
      "type": "npm",
      "script": "supabase:login",
      "path": ".",
      "presentation": {
        "group": "supabase",
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "🔗 Supabase: Link Project",
      "type": "npm",
      "script": "supabase:link",
      "path": ".",
      "presentation": {
        "group": "supabase",
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "📤 Supabase: Push Migrations",
      "type": "npm",
      "script": "supabase:push",
      "path": ".",
      "presentation": {
        "group": "supabase",
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "📥 Supabase: Pull Remote State",
      "type": "npm",
      "script": "supabase:pull",
      "path": ".",
      "detail": "Pulls schema from the linked remote project into a migration. This does not pull remote data.",
      "presentation": {
        "group": "supabase",
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "📊 Supabase: Check Migration Status",
      "type": "npm",
      "script": "supabase:status",
      "path": ".",
      "presentation": {
        "group": "supabase",
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "🔄 Supabase: Reset Local DB",
      "type": "npm",
      "script": "supabase:local:reset",
      "path": ".",
      "detail": "Destructively recreates only the local database and applies migrations without seed data.",
      "presentation": {
        "group": "supabase",
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "🌱 Supabase: Seed Local DB",
      "type": "npm",
      "script": "supabase:local:seed",
      "path": ".",
      "detail": "Applies repository seed files to the running local database without resetting it.",
      "presentation": {
        "group": "seed",
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "🐳 Supabase: Start Local DB",
      "type": "npm",
      "script": "supabase:local:start",
      "path": ".",
      "presentation": {
        "group": "supabase",
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "📊 Supabase: Local Status",
      "type": "npm",
      "script": "supabase:local:status",
      "path": ".",
      "presentation": {
        "group": "supabase",
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "⏹️ Supabase: Stop Local DB",
      "type": "npm",
      "script": "supabase:local:stop",
      "path": ".",
      "presentation": {
        "group": "supabase",
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "🩹 Supabase: Repair Migration History",
      "type": "shell",
      "command": "npm run supabase:repair -- --status ${input:supabaseMigrationStatus} ${input:supabaseMigrationVersion} --linked",
      "presentation": {
        "group": "supabase",
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "🌱 Supabase: Remote Seed",
      "type": "npm",
      "script": "supabase:remote:seed",
      "path": ".",
      "detail": "Applies repository seed files to the linked remote database without resetting it. Use only with a dedicated test project and verify the link first.",
      "presentation": {
        "group": "seed",
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "⚠️ Supabase: Reset REMOTE DB (destructive)",
      "type": "npm",
      "script": "supabase:remote:reset",
      "path": ".",
      "detail": "Destructively resets the linked database and reapplies migrations without seed data. Use only for a dedicated disposable project; verify the link before running.",
      "presentation": {
        "group": "supabase",
        "panel": "shared",
        "reveal": "always"
      }
    }
  ],
  "inputs": [
    {
      "id": "supabaseMigrationStatus",
      "type": "pickString",
      "description": "Mark this migration as applied (already run remotely) or reverted (never ran)?",
      "options": ["applied", "reverted"],
      "default": "applied"
    },
    {
      "id": "supabaseMigrationVersion",
      "type": "promptString",
      "description": "Migration version to repair (the digits before the first underscore in its filename)"
    }
  ]
}
