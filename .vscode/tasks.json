{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "💻 Frontend: Dev",
      "type": "npm",
      "script": "start",
      "path": "frontend",
      "presentation": {
        "group": "dev-env",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🖥️ Backend: Dev",
      "type": "npm",
      "script": "dev",
      "path": "backend",
      "presentation": {
        "group": "dev-env",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🚀 Dev: Start All",
      "dependsOn": ["💻 Frontend: Dev", "🖥️ Backend: Dev"],
      "dependsOrder": "parallel",
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "🧪 Frontend: Tests (watch)",
      "type": "npm",
      "script": "test:watch",
      "path": "frontend",
      "presentation": {
        "group": "testing",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🧪 Frontend: Tests (run once)",
      "type": "npm",
      "script": "test:run",
      "path": "frontend",
      "presentation": {
        "group": "testing",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🧪 Frontend: Tests (coverage report)",
      "type": "npm",
      "script": "test",
      "path": "frontend",
      "args": ["--", "--coverage"],
      "presentation": {
        "group": "testing",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🧪 Backend: Tests (watch)",
      "type": "npm",
      "script": "test:watch",
      "path": "backend",
      "presentation": {
        "group": "testing",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🧪 Backend: Tests (run once)",
      "type": "npm",
      "script": "test",
      "path": "backend",
      "options": {
        "env": {
          "NODE_ENV": "test",
          "CORS_ALLOWED_ORIGINS": "http://localhost:4200"
        }
      },
      "presentation": {
        "group": "testing",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🧪 Backend: Tests (coverage report)",
      "type": "npm",
      "script": "test:report",
      "path": "backend",
      "presentation": {
        "group": "testing",
        "panel": "dedicated",
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "📊 Test Reports: Generate",
      "type": "shell",
      "command": "npm --prefix backend run test:report ; npm --prefix frontend run test -- --coverage ; node scripts/collect-reports.mjs",
      "presentation": {
        "group": "testing",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🔍 Frontend: Lint",
      "type": "npm",
      "script": "lint",
      "path": "frontend",
      "problemMatcher": ["$eslint-stylish"],
      "presentation": {
        "group": "quality",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🔍 Backend: Lint",
      "type": "npm",
      "script": "lint",
      "path": "backend",
      "problemMatcher": ["$eslint-stylish"],
      "presentation": {
        "group": "quality",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🎨 Format: Check",
      "type": "npm",
      "script": "format:check",
      "path": ".",
      "presentation": {
        "group": "quality",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🎨 Format: Fix",
      "type": "npm",
      "script": "format",
      "path": ".",
      "presentation": {
        "group": "quality",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🏗️ Frontend: Build",
      "type": "npm",
      "script": "build",
      "path": "frontend",
      "presentation": {
        "group": "build",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🏗️ Frontend: Build (watch)",
      "type": "npm",
      "script": "watch",
      "path": "frontend",
      "presentation": {
        "group": "build",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🏗️ Backend: Build",
      "type": "npm",
      "script": "build",
      "path": "backend",
      "presentation": {
        "group": "build",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🔎 Backend: Typecheck",
      "type": "npm",
      "script": "typecheck",
      "path": "backend",
      "presentation": {
        "group": "quality",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🔧 Frontend: Lint (fix)",
      "type": "npm",
      "script": "lint:fix",
      "path": "frontend",
      "presentation": {
        "group": "quality",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🔧 Backend: Lint (fix)",
      "type": "npm",
      "script": "lint:fix",
      "path": "backend",
      "presentation": {
        "group": "quality",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "✅ CI: Verify All",
      "dependsOn": [
        "🧪 Frontend: Tests (run once)",
        "🧪 Backend: Tests (run once)",
        "🔍 Frontend: Lint",
        "🔍 Backend: Lint",
        "🎨 Format: Check",
        "🏗️ Frontend: Build",
        "🏗️ Backend: Build"
      ],
      "dependsOrder": "parallel",
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "📦 Install All Dependencies",
      "type": "npm",
      "script": "install:all",
      "path": ".",
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "🛠️ Setup: Create Environment Files",
      "type": "process",
      "command": "node",
      "args": ["scripts/setup-env.mjs"],
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "🧹 Clean: Build Artifacts",
      "type": "npm",
      "script": "clean",
      "path": ".",
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "🔐 Supabase: Login",
      "type": "npm",
      "script": "supabase:login",
      "path": ".",
      "presentation": {
        "group": "supabase",
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "🔗 Supabase: Link Project",
      "type": "npm",
      "script": "supabase:link",
      "path": ".",
      "presentation": {
        "group": "supabase",
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "📤 Supabase: Push Migrations",
      "type": "npm",
      "script": "supabase:push",
      "path": ".",
      "presentation": {
        "group": "supabase",
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "📥 Supabase: Pull Remote State",
      "type": "npm",
      "script": "supabase:pull",
      "path": ".",
      "presentation": {
        "group": "supabase",
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "📊 Supabase: Check Migration Status",
      "type": "npm",
      "script": "supabase:status",
      "path": ".",
      "presentation": {
        "group": "supabase",
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "🔄 Supabase: Reset Local DB",
      "type": "npm",
      "script": "supabase:reset",
      "path": ".",
      "detail": "Recreates the local Supabase database, applies migrations, and runs configured seed SQL. This removes local database data.",
      "presentation": {
        "group": "supabase",
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "⚠️ Supabase: Reset REMOTE DB (destructive)",
      "type": "npm",
      "script": "supabase:reset:remote",
      "path": ".",
      "detail": "Destructively resets the linked remote database without automatic seeds, then runs each remote seed and reports SUCCEEDED, SKIPPED, or ERROR. Confirm the linked project before running.",
      "presentation": {
        "group": "supabase",
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "🩹 Supabase: Repair Migration History",
      "type": "shell",
      "command": "npm run supabase:repair -- --status ${input:supabaseMigrationStatus} ${input:supabaseMigrationVersion} --linked",
      "presentation": {
        "group": "supabase",
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "🌱 Supabase: Seed Remote (no reset)",
      "type": "npm",
      "script": "supabase:seed:remote",
      "path": ".",
      "detail": "Runs SQL files from supabase/seeds against the linked remote database without resetting it. Each file reports SUCCEEDED, SKIPPED, or ERROR. Confirm the linked project before running.",
      "presentation": {
        "group": "seed",
        "panel": "shared",
        "reveal": "always"
      }
    }
  ],
  "inputs": [
    {
      "id": "supabaseMigrationStatus",
      "type": "pickString",
      "description": "Mark this migration as applied (already run remotely) or reverted (never ran)?",
      "options": ["applied", "reverted"],
      "default": "applied"
    },
    {
      "id": "supabaseMigrationVersion",
      "type": "promptString",
      "description": "Migration version to repair (the digits before the first underscore in its filename)"
    }
  ]
}
