# Runtime environment. Options: development, test, production.
NODE_ENV=development

# Port for the Express API. Render supplies PORT automatically in production.
PORT=3000

# Supabase: Dashboard > Project Settings > API Keys
SUPABASE_URL=https://<project-ref>.supabase.co

# Server-side key for Supabase calls made as the signed-in user, when needed.
# Keep this value private; do not add it to frontend/.env or expose it in browser code.
SUPABASE_ANON_KEY=sb_publishable_replace_me

# Privileged server-only key. It bypasses Row Level Security; scope every query
# with the authenticated user's ID. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me

# PostgreSQL URLs used by Prisma. Keep DIRECT_URL pointing to the direct
# database endpoint when DATABASE_URL is a pooled connection.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
DIRECT_URL=postgresql://postgres:password@localhost:5432/postgres

# Public web origin used to construct password reset links.
WEB_APP_URL=http://localhost:4200

# Optional SMTP configuration. In development, reset messages use ConsoleMailer.
# Production requires SMTP_HOST and SMTP_FROM.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# Comma-separated list of browser origins allowed to call this API.
# Local: http://localhost:4200
# Production: your deployed frontend URL (no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Only needed if the Supabase project still uses the legacy shared JWT signing secret.
# Modern Supabase signing keys should be verified through Supabase Auth instead.
# SUPABASE_JWT_SECRET=replace_me_only_if_legacy_jwt_verification_is_required
